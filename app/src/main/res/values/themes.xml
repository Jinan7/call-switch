<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CallSwitch" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="colorSurface">@color/blue</item>
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="materialSwitchStyle">@style/Widget.App.Switch</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
    </style>

    <!--    Toolbar styles -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Toolbar</item>
    </style>

    <style name="ThemeOverlay.App.Toolbar" parent="">
        <item name="colorSurface">@color/blue</item>
        <item name="colorOnSurface">@color/blue</item>
        <item name="colorSurfaceContainer">@color/blue</item>
        <item name="colorOnSurfaceVariant">@color/white</item>
        <item name="titleTextColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="popupTheme">@style/Widget.App.PopupMenu</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
    </style>

    <!--    Toolbar styles -->
    <style name="Widget.App.LightToolbar" parent="Widget.Material3.Toolbar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.LightToolbar</item>
    </style>

    <style name="ThemeOverlay.App.LightToolbar" parent="">
        <item name="colorSurface">@color/grey_2</item>
        <item name="colorOnSurface">@color/grey_2</item>
        <item name="colorSurfaceContainer">@color/grey_2</item>
        <item name="navigationIconTint">@color/grey_15</item>
        <item name="colorOnSurfaceVariant">@color/grey_15</item>
        <item name="titleTextColor">@color/grey_15</item>
        <item name="colorControlNormal">@color/grey_15</item>
        <item name="popupTheme">@style/Widget.App.PopupMenu</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <!--        <item name="fontFamily">@font/rubik</item>-->
        <!--        <item name="android:fontFamily">@font/rubik</item>-->
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <!--        <item name="fontFamily">@font/rubik</item>-->
        <!--        <item name="android:fontFamily">@font/rubik</item>-->
    </style>

    <!--    Toolbar styles -->
    <style name="Widget.App.SearchBar" parent="Widget.Material3.SearchBar">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.SearchBar</item>
    </style>

    <style name="ThemeOverlay.App.SearchBar" parent="">
        <item name="colorSurface">@color/grey_2</item>
        <item name="colorOnSurface">@color/grey_2</item>
        <item name="colorSurfaceContainer">@color/grey_2</item>
        <item name="navigationIconTint">@color/grey_10</item>
        <item name="colorOnSurfaceVariant">@color/grey_10</item>
        <item name="titleTextColor">@color/grey_10</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.App.TitleMedium</item>
    </style>

    <style name="TextAppearance.App.SearchBar" parent="TextAppearance.Material3.SearchBar">
        <item name="android:textColor">@color/white</item>

        <!--        <item name="fontFamily">@font/rubik</item>-->
        <!--        <item name="android:fontFamily">@font/rubik</item>-->
    </style>



    <!--    Bottom nav bar style    -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.BottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.BottomNavigationView" parent="">
        <!--        icon and text color for unselected item -->
        <item name="colorOnSurfaceVariant">@color/white</item>
        <!--        background color -->
        <item name="colorSurfaceContainer">@color/blue</item>
        <!--        text color for selected item -->
        <item name="colorSecondary">@color/blue</item>
        <!--        background color for selected item -->
        <item name="colorSecondaryContainer">@color/white</item>
        <!--        icon color for selected item -->
        <item name="colorOnSecondaryContainer">@color/blue</item>
    </style>

    <!--    Light Bottom nav bar style    -->
    <style name="Widget.App.LightBottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.LightBottomNavigationView</item>
    </style>

    <style name="ThemeOverlay.App.LightBottomNavigationView" parent="">
        <!--        icon and text color for unselected item -->
        <item name="colorOnSurfaceVariant">@color/blue</item>
        <!--        background color -->
        <item name="colorSurfaceContainer">@color/grey_2</item>
        <!--        text color for selected item -->
        <item name="colorSecondary">@color/white</item>
        <!--        background color for selected item -->
        <item name="colorSecondaryContainer">@color/blue</item>
        <!--        icon color for selected item -->
        <item name="colorOnSecondaryContainer">@color/white</item>
    </style>


    <!--   switch style -->
    <style name="Widget.App.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="materialThemeOverlay">@style/ThemeOverlay.App.Switch</item>
    </style>

    <style name="ThemeOverlay.App.Switch" parent="">
        <item name="colorPrimary">@color/blue</item>
        <item name="colorSurfaceVariant">@color/blue_1</item>
        <item name="colorSurfaceContainerHighest">@color/grey_7</item>
    </style>
    <style name="Theme.CallSwitch" parent="Base.Theme.CallSwitch" />


    <!--    Pop up menu style -->
    <style name="Widget.App.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:backgroundTint">@color/white</item>
        <item name="android:textColor">@color/grey_15</item>
    </style>


</resources>