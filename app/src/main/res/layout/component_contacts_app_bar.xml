<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar_main"
    style="@style/Widget.App.LightToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:statusBarForeground="@color/blue"
    android:fitsSystemWindows="true">

<!--    <com.google.android.material.appbar.MaterialToolbar-->
<!--        android:id="@+id/select_contacts_toolbar"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:minHeight="?attr/actionBarSize"-->
<!--        app:title="Contacts"/>-->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        app:layout_scrollFlags="enterAlways|scroll|snap">

    <com.google.android.material.search.SearchBar
        style="@style/Widget.App.SearchBar"
        android:textAppearance="@style/TextAppearance.App.SearchBar"
        android:id="@+id/contact_search_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/grey_2"
        android:hint="@string/search_contacts" />
    </com.google.android.material.appbar.MaterialToolbar>
</com.google.android.material.appbar.AppBarLayout>