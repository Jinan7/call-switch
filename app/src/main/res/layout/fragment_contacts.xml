<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_fragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RepliesActivity">

    <include layout="@layout/component_contacts_app_bar"/>

    <RelativeLayout

        android:layout_width="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:layout_above="@id/bottom_nav_view"
            android:id="@+id/contacts_recycler_view"
            android:paddingTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <include layout="@layout/component_bottom_nav_bar"
            android:id="@+id/bottom_nav_view"/>

    </RelativeLayout>

    <com.google.android.material.search.SearchView
        android:id="@+id/contact_search_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@id/contact_search_bar"
        android:hint="@string/search_contacts">
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginHorizontal="8dp"
            android:fitsSystemWindows="true"
            android:clipToPadding="false"
            android:id="@+id/contact_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.google.android.material.search.SearchView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>