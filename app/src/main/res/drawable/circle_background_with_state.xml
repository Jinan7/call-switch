<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@+id/circle_background"
        android:width="50dp"
        android:height="50dp">
        <shape android:shape="oval">
            <solid android:color="@color/grey_7"/>
            <stroke android:color="@color/grey_15"
                android:width="2dp"/>
        </shape>
    </item>
    <item android:id="@+id/state_circle_background"
        android:height="10dp"
        android:width="10dp"
        android:left="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/grey_7"/>
            <stroke android:color="@color/white"
                android:width="1dp"/>
        </shape>
    </item>
</layer-list>